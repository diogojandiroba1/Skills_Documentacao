\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilo}[2026/09/14 v2.5 Estilo Executivo Minimalista de Mercado]

% Pacotes Matemáticos e Símbolos
\RequirePackage{amsmath}
\RequirePackage{amssymb}

% Pacotes Gráficos e Vetoriais
\RequirePackage{graphicx}
\RequirePackage[export]{adjustbox}
\RequirePackage{tikz}
\usetikzlibrary{shapes,arrows,positioning,calc,fit,shapes.geometric,arrows.meta,trees,automata,shadows,decorations.pathreplacing}

% Configurações e Estilos Compartilhados para TikZ (SEM LINHAS EM BRANCO INTERNAS)
\tikzset{
    base/.style={draw=primary, thick, align=center, font=\small\sffamily},
    block/.style={base, rectangle, rounded corners=3pt, fill=white, inner sep=6pt},
    block_gray/.style={base, rectangle, rounded corners=3pt, fill=bgneutral, inner sep=6pt},
    block_accent/.style={base, rectangle, rounded corners=3pt, fill=borderline!40, draw=primary, inner sep=6pt},
    actor/.style={base, circle, minimum size=0.8cm, fill=white},
    usecase/.style={base, ellipse, fill=white, inner sep=5pt, minimum width=2.5cm, minimum height=1.1cm},
    state_node/.style={base, rectangle, rounded corners=6pt, fill=white, inner sep=6pt, minimum width=2.2cm},
    initial_state/.style={circle, fill=primary, inner sep=0pt, minimum size=0.35cm},
    final_state/.style={circle, fill=white, draw=primary, double=primary, double distance=1.5pt, inner sep=0pt, minimum size=0.45cm},
    action_node/.style={base, rectangle, rounded corners=8pt, fill=white, inner sep=6pt},
    decision_node/.style={base, diamond, aspect=1.5, fill=white, inner sep=3pt},
    bar_node/.style={fill=primary, rectangle, minimum height=3pt, minimum width=2.5cm, inner sep=0pt},
    line/.style={draw=primary, thick, -{Latex[length=2.5mm]}},
    line_dashed/.style={draw=primary, dashed, thick, -{Latex[length=2.5mm]}},
    line_plain/.style={draw=primary, thick},
    component/.style={base, rectangle, fill=white, inner sep=8pt, minimum width=2.8cm},
    database_node/.style={base, cylinder, shape border rotate=90, aspect=0.25, fill=white, inner sep=5pt, minimum width=1.8cm, minimum height=1.6cm}
}

% Tabelas Limpas Padrão Executivo (booktabs)
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{colortbl}
\RequirePackage{multirow}
\RequirePackage{float}

\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}

\definecolor{headergray}{RGB}{243, 244, 246} % Fundo suave do cabeçalho da tabela
\definecolor{linegray}{RGB}{229, 231, 235}   % Linhas de grade sutis
\colorlet{tableheader}{headergray}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% LISTINGS E FORMATAÇÃO DE CÓDIGO FONTE (MONO CORPORATIVO)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\RequirePackage{listings}

\lstdefinestyle{moderncode}{
    backgroundcolor=\color{bgneutral},
    basicstyle=\ttfamily\small\color{primary},
    keywordstyle=\bfseries\color{primary},
    commentstyle=\itshape\color{textmuted},
    stringstyle=\color{secondary},
    numberstyle=\tiny\color{textmuted},
    numbers=left,
    numbersep=8pt,
    stepnumber=1,
    breaklines=true,
    breakatwhitespace=true,
    frame=single,
    rulecolor=\color{borderline},
    tabsize=2,
    showstringspaces=false,
    captionpos=b,
    xleftmargin=12pt,
    framexleftmargin=12pt
}

\lstset{style=moderncode}

