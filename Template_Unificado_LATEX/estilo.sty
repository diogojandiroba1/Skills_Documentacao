%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% MACROS PARA INCLUSÃO PADRONIZADA DE DIAGRAMAS E FIGURAS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\incluirdiagrama}[3]{%
  \begin{figure}[htbp]
    \centering
    \includegraphics[width=0.9\textwidth,height=0.45\textheight,keepaspectratio]{#1}
    \caption{#2}\label{#3}
  \end{figure}
}

\newcommand{\incluirdiagramalargo}[3]{%
  \begin{figure}[htbp]
    \centering
    \includegraphics[width=\textwidth,height=0.65\textheight,keepaspectratio]{#1}
    \caption{#2}\label{#3}
  \end{figure}
}

\newcommand{\incluirdiagramacompacto}[3]{%
  \begin{figure}[htbp]
    \centering
    \includegraphics[width=0.75\textwidth,height=0.35\textheight,keepaspectratio]{#1}
    \caption{#2}\label{#3}
  \end{figure}
}

